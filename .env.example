# Supabase — copy this file to .env.local and fill in real values.
# Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# App base URL — used by the journal worker for self-chaining + sync nudges.
NEXT_PUBLIC_APP_URL=https://app.marketmakersfx.net

# Bearer secret for the existing daily-stats cron.
CRON_SECRET=GENERATE_A_LONG_RANDOM_STRING

# Separate bearer secret for the journal sync worker (kept distinct from
# CRON_SECRET so the two crons can be rotated independently).
JOURNAL_CRON_SECRET=GENERATE_A_LONG_RANDOM_STRING

# AI Trading Journal — MetaApi (cloud MT5 bridge, https://metaapi.cloud).
# Investor passwords are passed through to MetaApi and never stored.
METAAPI_TOKEN=YOUR_METAAPI_TOKEN
METAAPI_REGION=london

# Anthropic — powers the growth narrative AND the journal AI coach (Phase 3).
ANTHROPIC_API_KEY=sk-ant-...
