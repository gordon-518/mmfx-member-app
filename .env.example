# Supabase — copy this file to .env.local and fill in real values.
# Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# App base URL — used by the journal worker for self-chaining + sync nudges.
NEXT_PUBLIC_APP_URL=https://app.marketmakersfx.net

# Bearer secret for the existing daily-stats cron.
CRON_SECRET=GENERATE_A_LONG_RANDOM_STRING

# Separate bearer secret for the journal sync worker (kept distinct from
# CRON_SECRET so the two crons can be rotated independently).
JOURNAL_CRON_SECRET=GENERATE_A_LONG_RANDOM_STRING

# AI Trading Journal — MetaApi (cloud MT5 bridge, https://metaapi.cloud).
# Investor passwords are passed through to MetaApi and never stored.
METAAPI_TOKEN=YOUR_METAAPI_TOKEN
METAAPI_REGION=london

# Anthropic — powers the growth narrative AND the journal AI coach (Phase 3).
ANTHROPIC_API_KEY=sk-ant-...

# Admin alerts (new deposit submissions). @MMbrainerbot on the VPS, so alerts
# land where they are watched. Falls back to TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID.
ADMIN_ALERT_BOT_TOKEN=
ADMIN_ALERT_CHAT_ID=
# Where the admin email alerts go (defaults to gordon@marketmakersfx.net).
ALERT_TO_EMAIL=

# ---------------------------------------------------------------------------
# Email lifecycle rail (design doc 2026-09-21 §4). Uses CRON_SECRET above, for
# both /api/cron/email-lifecycle and the brain's /api/email/spotlight.
# ---------------------------------------------------------------------------
# THE KILL SWITCH. Nothing is claimed and nothing is sent unless this is
# exactly "true". Leave it off until the copy is approved and the migration
# has been exercised on a Supabase branch.
EMAIL_LIFECYCLE_ENABLED=false
# The marketing From. A dedicated sender/subdomain is strongly recommended so
# OTP codes never share sending reputation with marketing volume (decision 1).
EMAIL_FROM_MARKETING=Market Makers FX <hello@marketmakersfx.net>
# Free-tier digest cadence, ISO day-of-week (Mon=1). Default Mon/Wed/Fri.
DIGEST_DAYS=1,3,5
# Weekly feature-spotlight day, ISO day-of-week. Default Thursday, which keeps
# it off the digest days.
SPOTLIGHT_DAY=4
# Rows claimed per hourly run. Optional; defaults to 60 — small on purpose, so
# a run killed mid-batch strands few claims for the reaper to unwind.
EMAIL_LIFECYCLE_BATCH=60
